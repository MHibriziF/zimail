# Settings for the self-hosted server (docker compose). Copy to zimail.env.
# Only ORIGIN and a mail provider are required; everything else is optional.

# The address people open, with no trailing slash. With the Caddy profile, use https://$ZIMAIL_DOMAIN.
ORIGIN=https://mail.example.com
# Used by the Caddy profile for its certificate.
ZIMAIL_DOMAIN=mail.example.com

# --- Sending: any SMTP relay (Postmark, SES, Mailgun, Brevo, your ISP, a local Postfix) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls (465) | starttls (587) | none (a local relay with no password)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_DOMAINS=example.com
# Or Resend instead: EMAIL_PROVIDER=resend, RESEND_API_KEY=…, RESEND_WEBHOOK_SECRET=…

# --- Receiving: raw MIME posted to https://$ORIGIN/api/webhooks/inbound ---
# From your MX (a Postfix pipe), SendGrid Inbound Parse (raw) or a Mailgun route. Long and random.
INBOUND_WEBHOOK_SECRET=

# --- AI (optional; leave unset and the AI controls hide) ---
# AI_PROVIDER=openai
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=qwen3:30b
# Or the free Workers AI allowance over REST:
# AI_PROVIDER=workers-ai-rest
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=

# --- Notifications and meetings (optional) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# APP_URL=https://mail.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
